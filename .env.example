# ============================================================
# PDF 翻译阅读器 —— 配置模板
#
# 用法：把本文件复制一份改名为 .env，然后填上你自己的值。
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# .env 已被 .gitignore 排除，你的 API Key 不会被提交上去。
#
# 应用启动时会读这个文件；也可以在设置界面里改，点保存时会写回 .env。
# 两者冲突时**以文件为准**（因为浏览器本地存储是按「来源」隔离的，
# 端口一变就丢了，所以配置的权威来源是磁盘文件）。
#
# 把某个字段写成空（例如 API_KEY=""）表示"它确实是空的"，会覆盖浏览器里的旧值 ——
# 也就是说想彻底清掉某个设置，把它清空即可。不写这个字段则维持原样。
# ============================================================

# 服务端口。留空则用 5199；被别的程序占用时会自动往后找空闲端口。
PORT=5199

# OpenAI 兼容接口的 base 地址。DeepSeek 用下面这个。
BASE_URL="https://api.deepseek.com/v1"

# 你的 API Key，去 https://platform.deepseek.com 申请。
API_KEY=""

# 模型名由服务商决定，以当前可用列表为准。
# 不确定该填什么，就启动后在设置界面点「测试连接」，
# 它会直接拉取你这个账号当前真正可用的模型列表。
MODEL="deepseek-flash"

# 温度：0 最保守、2 最发散。学术翻译建议 0.2 ~ 0.5。
TEMPERATURE=0.3

# 触发方式：auto = 选中即翻；shortcut = 选中后按 Ctrl+Enter 才翻。
TRIGGER="auto"

# 触发前的防抖毫秒数（trigger=auto 时生效）。
# 拖选时选区会不断变化，防抖能让"停手之后"才真正发请求。
DEBOUNCE_MS=1000

# 打开 PDF 时的初始缩放倍数：1 = 100%，1.5 = 150%
DEFAULT_ZOOM=1.5

# 页面护眼色调（也可以直接点工具栏上的「背景」按钮循环切换）：
#   none  = 原色
#   green = 护眼绿（RGB 220 232 205）
#   yellow= 淡黄
#   sepia = 羊皮纸（暖棕）
PAGE_TINT="none"

# 全文翻译 PDF 的保存目录。留空时保存到 %USERPROFILE%\PDF译文。
# 自定义路径不可写时会退回用户目录，不存在的目录会先创建。
# OUTPUT_DIR="D:\\文献译本"

# 思考模式强度：
#   none  = 关闭思考（推荐）
#   low / high / max = 开启思考，越往后越慢
#   omit  = 完全不发送这个参数（给不认 reasoning_effort 的服务商用）
#
# 参数支持及默认行为由服务商决定，不支持时使用 omit。
REASONING="none"

# 系统提示词：留空/不写 = 使用内置默认提示词（推荐）。
# 它在设置界面里可以编辑；改过之后会被自动追加到 .env 的这一项里，
# 多行内容会以单行 + \n 转义的形式保存。
# SYSTEM_PROMPT=""
