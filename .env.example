# ============================================================
# PDF 翻译阅读器 —— 配置模板
#
# 用法：把本文件复制一份改名为 .env，然后填上你自己的值。
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# .env 已被 .gitignore 排除，你的 API Key 不会被提交上去。
#
# 应用启动时会读这个文件；也可以在设置界面里改，点保存时会写回 .env。
# 两者冲突时**以文件为准**（因为浏览器本地存储是按「来源」隔离的，
# 端口一变就丢了，所以配置的权威来源是磁盘文件）。
#
# 把某个字段写成空（例如 MIMO_API_KEY=""）表示"它确实是空的"，会覆盖浏览器里的旧值 ——
# 也就是说想彻底清掉某个设置，把它清空即可。不写这个字段则维持原样。
# ============================================================

# 服务端口。留空则用 5199；被别的程序占用时会自动往后找空闲端口。
PORT=5199

# 当前使用的服务商：deepseek / mimo / custom。
# 各家配置独立保存；切换只改变当前选择，不会覆盖另一家的 Key。
ACTIVE_PROVIDER="deepseek"

# -------- DeepSeek --------
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_REASONING="none"

# -------- 小米 MiMo --------
# Key 在 https://platform.xiaomimimo.com/ 获取。
MIMO_BASE_URL="https://api.xiaomimimo.com/v1"
MIMO_API_KEY=""
MIMO_MODEL="mimo-v2.6-flash"
MIMO_TEMPERATURE=0.3
MIMO_REASONING="none"

# -------- 其他 OpenAI 兼容接口 --------
CUSTOM_BASE_URL="https://api.openai.com/v1"
CUSTOM_API_KEY=""
CUSTOM_MODEL=""
CUSTOM_TEMPERATURE=0.3
CUSTOM_REASONING="none"

# -------- 共享的阅读设置 --------
# 触发方式：auto = 选中即翻；shortcut = 选中后按 Ctrl+Enter 才翻。
TRIGGER="auto"

# 触发前的防抖毫秒数（trigger=auto 时生效）。
# 拖选时选区会不断变化，防抖能让"停手之后"才真正发请求。
DEBOUNCE_MS=1000

# 打开 PDF 时的初始缩放倍数：1 = 100%，1.5 = 150%
DEFAULT_ZOOM=1.5

# 页面护眼色调（也可以直接点工具栏上的「背景」按钮循环切换）：
#   none  = 原色
#   green = 护眼绿（RGB 220 232 205）
#   yellow= 淡黄
#   sepia = 羊皮纸（暖棕）
PAGE_TINT="none"

# 全文翻译 PDF 的保存目录。留空时保存到 %USERPROFILE%\PDF译文。
# 自定义路径不可写时会退回用户目录，不存在的目录会先创建。
# OUTPUT_DIR="D:\\文献译本"

# 各家 *_REASONING 中：none = 关闭思考，omit = 不发送思考参数。
# 小米 MiMo 的 none 自动转换为 thinking.type=disabled。

# 系统提示词：留空/不写 = 使用内置默认提示词（推荐）。
# 它在设置界面里可以编辑；改过之后会被自动追加到 .env 的这一项里，
# 多行内容会以单行 + \n 转义的形式保存。
# SYSTEM_PROMPT=""
